# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=iot_user
DB_PASSWORD=iot_password
DB_DATABASE=iot_monitoring

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka
KAFKA_BROKER=kafka:9092

# MQTT
MQTT_BROKER=mqtt://mosquitto:1883

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_EXPIRATION=900
JWT_ISSUER=iot-monitoring-api
JWT_AUDIENCE=iot-monitoring-demo
SESSION_EXPIRATION=86400

# Master user (created only when no master exists)
MASTER_USERNAME=admin
MASTER_PASSWORD=change-this-master-password
MASTER_NAME=Platform Administrator

# Browser client
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Services Ports
API_GATEWAY_PORT=3000
DEVICE_SERVICE_PORT=3001
ANALYTICS_SERVICE_PORT=3002
ALERTS_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004

# Node Environment
NODE_ENV=development
